VAULT_RECALL_PATH=C:\path\to\your\Obsidian\vault\Recall

# Cross-device sync (Upstash Redis via Vercel Storage → Upstash for Redis).
# Vercel sets these automatically when the database is connected to the
# project; copy them here only to sync while running locally. Without them the
# app stays local-only per browser, as before.
KV_REST_API_URL=
KV_REST_API_TOKEN=
