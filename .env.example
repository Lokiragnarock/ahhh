VAULT_RECALL_PATH=C:\path\to\your\Obsidian\vault\Recall

# Cross-device sync. Vercel sets one of these automatically when a Redis
# database is connected to the project; copy the matching one here to sync
# while running locally. Without either, the app stays local-only per
# browser, as before.
#
# Redis Cloud / Vercel Storage -> Redis (TCP connection string):
REDIS_URL=

# Upstash Redis via Vercel Storage -> Upstash for Redis (REST API):
KV_REST_API_URL=
KV_REST_API_TOKEN=
